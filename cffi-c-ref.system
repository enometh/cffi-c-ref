(in-package "CL-USER")

(defvar *cffi-c-ref-source-dir*
  (merge-pathnames "cffi-c-ref/" (translate-logical-pathname "EXTERN:")))
(defvar *cffi-c-ref-binary-dir* (binary-directory *cffi-c-ref-source-dir*))

(mk:defsystem :cffi-c-ref
  :source-pathname *cffi-c-ref-source-dir*
  :binary-pathname *cffi-c-ref-binary-dir*
  :source-extension "lisp"
  :depends-on (:alexandria :cffi)
  :components ((:file "cffi-c-ref")))

#+nil
(mk:oos :cffi-c-ref :load :compile-during-load t)

(mk:defsystem :cffi-c-ref/tests
  :source-pathname *cffi-c-ref-source-dir*
  :binary-pathname *cffi-c-ref-binary-dir*
  :source-extension "lisp"
  :depends-on (:alexandria :cffi-c-ref :fiveam)
  :components ((:file "cffi-c-ref-tests")))

#+nil
(mk:oos :cffi-c-ref/tests :load :compile-during-load t)

#+nil
(5am:run  :cffi-c-ref.tests)